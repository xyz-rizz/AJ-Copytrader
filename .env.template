# ─────────────────────────────────────────────────────────────────
#  Polymarket Copy-Trade Bot — Configuration
#  cp .env.template .env  then fill in your values
#  NEVER commit .env to git. NEVER share PRIVATE_KEY.
# ─────────────────────────────────────────────────────────────────

# ── Polymarket Keys ────────────────────────────────────────────────
#
# PRIVATE_KEY: Your Rabby/MetaMask EOA private key.
# This is the wallet you connected to Polymarket — it signs CLOB messages.
#
PRIVATE_KEY=0xYOUR_RABBY_EOA_PRIVATE_KEY_HERE

# POLY_FUNDER_ADDRESS: The Polymarket proxy/trading wallet Polymarket created
# for your account. This is where your USDC balance lives.
# Find it: polymarket.com → click your profile icon → copy the 0x... address shown
POLY_FUNDER_ADDRESS=0xYOUR_POLYMARKET_PROXY_WALLET_HERE

# POLY_SIGNATURE_TYPE:
#   2 = GNOSIS_SAFE — MetaMask/Rabby connected via Polymarket browser (MOST COMMON)
#   1 = POLY_PROXY  — Magic Link / email wallet
#   0 = EOA         — direct wallet, no proxy (rare)
POLY_SIGNATURE_TYPE=2

# API credentials from polymarket.com → Settings → API
# Required when using a funder/proxy wallet (above)
POLY_API_KEY=
POLY_API_SECRET=
POLY_API_PASSPHRASE=

# ── Trading ────────────────────────────────────────────────────────
# USDC stake per copy trade
STAKE_USDC=5.0

# Poll interval in seconds (30 = safe baseline)
POLL_INTERVAL=30

# Which traders to copy: 1 = P1 only (top ROI), 2 = all traders
PRIORITY_LEVEL=1

# Skip SELL activity (exits) — recommended true for most traders
SKIP_SELLS=true

# ── Safety — leave defaults until you understand the bot ──────────
# DRY_RUN: true = log only, no real orders. Set false to go live.
DRY_RUN=true

# Max allowed price slippage vs trader's signal price (0.05 = 5%)
MAX_SLIPPAGE=0.05

# Max USDC to deploy into any single market token
MAX_PER_MARKET_USDC=50.0

# Pause all trading if estimated daily loss exceeds this
MAX_DAILY_LOSS_USDC=50.0

# Aggregate rapid micro-fills within this window before copying (seconds)
FILL_AGG_WINDOW_SEC=60

# ── Telegram Notifications (optional but recommended) ─────────────
# Get your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# How to get TELEGRAM_CHAT_ID:
#   1. Message your bot on Telegram (search its username, send /start)
#   2. Visit: https://api.telegram.org/bot{TOKEN}/getUpdates
#   3. Find "chat":{"id": YOUR_ID} in the JSON response
TELEGRAM_CHAT_ID=

# ── Proxy (required if VPS IP is geo-blocked by Polymarket) ──────
# Format: http://username:password@host:port
# Leave blank for direct connection (local / unblocked VPS)
PROXY_URL=

# ── Polymarket CLOB (do not change) ───────────────────────────────
CLOB_HOST=https://clob.polymarket.com
CHAIN_ID=137
